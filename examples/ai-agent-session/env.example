# examples/ai-agent-session/env.example - copy to env.local in this folder and edit.
# env.local is not part of the repository. The scripts run_tests.sh, qrun.sh and vm_ctl.sh read it.
#
# Before the first run (see the repository README, "Run unit tests in the guest from the host"):
#   make                                                    # build/fs-9p
#   SSH_IDENT=~/.ssh/id_ed25519.pub tools/make-image.sh "$IMAGE"
# The image starts fs-9p at boot and accepts root ssh logins with that key; vm_ctl.sh boots it with
# tools/qnx-share.sh.

# ssh name of the Linux machine that has QNX SDP 8.0, CMake and QEMU with KVM.
# Empty: that machine is this one, and the scripts run their commands here without ssh.
BUILD_HOST=
# All paths below are paths on that machine.
REPO=/home/me/fs-9p                     # this repository (tools/qnx-run, tools/qnx-share.sh)
SDP_ENV=/home/me/qnx800/qnxsdp-env.sh   # QNX SDP 8.0 environment script (puts qcc into PATH)
CMAKE_ENV=/dev/null                     # script that puts cmake and ctest 3.21 or newer into PATH
QEMU_ENV=/dev/null                      # script that puts qemu-system-x86_64 into PATH
IMAGE=/home/me/fs9p-image               # image folder made by tools/make-image.sh with SSH_IDENT
SHARE=/home/me/qnx-share                # host folder that the guest sees at /mnt/host
PROJ=ai_session                         # subfolder of SHARE for this project and its build
SSH_PORT=2222                           # host port forwarded to the guest's ssh port
SSH_KEY=/home/me/.ssh/id_ed25519        # private half of the SSH_IDENT key (empty: ssh's default)
