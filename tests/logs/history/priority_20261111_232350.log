 4489244   4 tmp/fs9p/fs-9p                40r CONDVAR        (0x5196a3e430)              
 4489244   5 tmp/fs9p/fs-9p                40r RECEIVE        1                           
# interrupt thread (the fs-9p thread in state INTR): priority 21

qnx# cat prio_md5.txt   # md5sum of the data the reader got (the host's md5 in brackets)
18222d81acf39903c9e01cff6ad889a4  (host: 18222d81acf39903c9e01cff6ad889a4)

qnx# slay fs-9p   # unmount; fs-9p prints its statistics
