=== command block from README.md (run unchanged):
mkdir -p "$SHARE"
[ -f overlay.qcow2 ] || qemu-img create -f qcow2 -b output/disk-qemu.vmdk -F vmdk overlay.qcow2
qemu-system-x86_64 -enable-kvm -cpu host -smp 4 -m 4G \
  -drive file=overlay.qcow2,if=ide,id=drv0 \
  -netdev user,id=net0,hostfwd=tcp:127.0.0.1:${SSH_PORT}-:22 \
  -device virtio-net-pci,netdev=net0,mac=52:54:00:91:01:ea \
  -kernel output/ifs.bin -serial mon:stdio \
  -object rng-random,filename=/dev/urandom,id=rng0 -device virtio-rng-pci,rng=rng0 \
  -vga none -display none \
  -fsdev local,id=fs0,path="$SHARE",security_model=none \
  -device virtio-9p-pci,fsdev=fs0,mount_tag=hostshare

