# tests/env.example - copy to tests/env.local and edit. tests/env.local is not part of the repository.
BUILD_HOST=qemu-host                       # ssh name of the Linux machine that runs QEMU and has QNX SDP 8.0
REMOTE_DIR=/home/me/fs-9p                  # where the sources are copied and built on BUILD_HOST
SDP_ENV=/home/me/qnx800/qnxsdp-env.sh      # QNX SDP 8.0 environment script on BUILD_HOST
SHARE=/home/me/fs-9p/share                 # folder given to QEMU: -fsdev local,id=fs0,path=$SHARE,security_model=none
GUEST_SSH="ssh -p 2222 root@127.0.0.1"     # runs a command as root in the QNX guest (run on BUILD_HOST)
GUEST_SCP="scp -P 2222"                    # copies files into the guest
GUEST_DEST="root@127.0.0.1:"               # destination prefix for GUEST_SCP
# optional: second host folder for the two-device test (tests/host_side.sh). Start QEMU with the two
# extra options -fsdev local,id=fs1,path=$SHARE2,security_model=none
#                -device virtio-9p-pci,fsdev=fs1,mount_tag=share2,disable-legacy=on
SHARE2=/home/me/fs-9p/share2
# optional, for demo/priority.sh and the request-slot step of tests/host_side.sh: third host folder,
# exported as a device whose reads QEMU throttles, so that a read stays in flight long enough for
# pidin and a low-priority reader keeps the one request slot of fs-9p -n 1 busy. QEMU options:
#   -fsdev local,id=fs2,path=$SLOW_SHARE,security_model=none,throttling.bps-read=262144
#   -device virtio-9p-pci,fsdev=fs2,mount_tag=slow
SLOW_SHARE=/home/me/fs-9p/share3
SLOW_TAG=slow
# optional: script that puts the qemu-system-x86_64 that runs the guest into PATH (for the log)
QEMU_ENV=
# optional: script that puts cmake and ctest (3.21 or newer) into PATH, for the ctest part of the
# tools/qnx-run step (skipped without cmake)
CMAKE_ENV=
# optional: gcovr command for the coverage step (default gcovr; without it the SDP's gcov summary)
GCOVR=
